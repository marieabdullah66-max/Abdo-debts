# Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_SERVICE_ROLE_KEY

# Optional security/login settings
SHOW_LOGIN_ACCOUNTS=false
LOGIN_MAX_FAILURES=8
LOGIN_FAILURE_WINDOW_SECONDS=600

# Optional comma-separated origins if the API is exposed to another frontend.
# ALLOWED_ORIGINS=https://example.com
